{
  "expo": {
    "name": "SortMyDump",
    "slug": "brain-dump-organizer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "braindumporganizer",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/SortMyDumpIcon.png",
        "backgroundImage": "./assets/images/SortMyDumpIcon.png",
        "monochromeImage": "./assets/images/SortMyDumpIcon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dooom.braindumporganizer"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "dfc9be4f-1303-48c3-ab24-9f9e4e7c8896"
      }
    }
  }
}
